{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-undef": "off",
    "typescript/no-unused-vars": "warn",
    "no-unused-vars": "off"
  },
  "ignorePatterns": ["node_modules/**", ".tsbuild/**"]
}
