{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foundations",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The static site Rspress builds; the worker runs first only on its own routes.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/u/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundations",
      // The production id is set once the author has created the database; locally any value works.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "PUBLIC_ORIGIN": "https://foundations.steme.dev" },
  "observability": { "enabled": true },
}
