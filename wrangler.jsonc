{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foundations",
  "main": "worker/index.ts",
  // The card's fonts, bundled as bytes (resvg's WebAssembly is compiled by default).
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "compatibility_date": "2026-11-01",
  // Served only at its own domain, which `wrangler deploy` attaches.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "foundations.steme.dev", "custom_domain": true }],
  // The static site Rspress builds; the worker runs first only on its own routes.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*", "/t/*", "/u/*", "/fr/u/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundations",
      "database_id": "074e65f4-7437-4ccd-a449-d210dba02813",
      "migrations_dir": "migrations",
    },
  ],
  // POSTHOG_KEY: PostHog's project key, public like every PostHog key; empty, nothing is counted.
  "vars": {
    "PUBLIC_ORIGIN": "https://foundations.steme.dev",
    "POSTHOG_KEY": "phc_pUgZNXtjqSMmh6EKi3J83vo7Yo9s7ANEZSxahiSr7Qih",
  },
  "observability": { "enabled": true },
}
